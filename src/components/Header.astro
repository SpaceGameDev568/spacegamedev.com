---

import SidebarButton from './SidebarButton.astro';

import SidebarToggleButton from '../components/react/SidebarToggleButton.tsx';

const props = Astro.props

import '../styles/global.css';

---

<div id="header" class="fixed h-13 bg-[#222225]/50 w-full z-50 backdrop-blur-xs">

	<SidebarToggleButton client:only="react"/>

	<p class="font-heading font-bold text-2xl mt-2 mr-10 ml-auto text-right w-fit text-white float-right invisible md:visible" title="Page Title">{props.pageName}</p>

</div>

<div id="sidebar" class="block fixed h-[calc(100%-3.25rem)] top-13 w-full -left-full md:w-60 md:-left-60  m-0  md:rounded-br-2xl z-50 bg-[#222225]/50 backdrop-blur-xs md:after:w-25 md:after:bg-blue-500" transition:persist>

	<h1 class="text-white font-bold text-2xl ml-auto mr-auto font-heading text-left md:hidden w-[90%]">
		SpaceGameDev
		<br/>
		Modding
	</h1>

	<SidebarButton title="Home" image="/../../images/MaterialIcons/home_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg" link="/"/>
	<SidebarButton title="Links" image="/../../images/MaterialIcons/link_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg" link="/linkinbio" />
	<SidebarButton title="Hosting" image="/../../images/MaterialIcons/dns_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg" link="/hosting" />
	<hr class="border-white/20" />
	<SidebarButton title="Docs" image="/../../images/MaterialIcons/book_2_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg" link="https://docs.spacegamedev.com" />
	<SidebarButton title="Discord" image="/../../images/Icons/DiscordWhite.svg" link="/discord" />

	<div class="w-fit ml-auto mr-auto">
		<div class="md:float-left w-45.5 overflow-x-hidden">
			<iframe title="Better Stack Status" src="https://status.spacegamedev.com/badge?theme=dark" id="betterstack-badge" width="250" height="30" loading="eager"></iframe>
		</div>
	</div>

</div>

<script>

	import { animate } from "motion"

	animate("#header", { y: [-50, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

</script>