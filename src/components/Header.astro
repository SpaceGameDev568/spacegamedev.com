---

import {Image} from 'astro:assets';

import SidebarButton from './SidebarButton.astro';
import SidebarToggleButton from './react/SidebarToggleButton.tsx';

const props = Astro.props

---

<div id="header" class="fixed h-[3.25rem] bg-[#222225]/50 w-full z-50 backdrop-blur-xs">

	<SidebarToggleButton client:only />

	<p class="font-heading font-bold text-2xl mt-2 mr-10 ml-auto text-right w-fit text-white float-right invisible md:visible" title="Page Title">{props.pageName}</p>

</div>

<div id="sidebar" class="block fixed h-[calc(100%-3.25rem)] top-[3.25rem] w-[100%] -left-[100%] md:w-[15rem] md:left-[-15rem]  m-0  md:rounded-br-2xl md:shadow-2xl z-50 bg-[#222225]/50 backdrop-blur-xs md:after:w-[100px] md:after:bg-blue-500" transition:persist>

	<h1 class="text-white font-bold text-2xl ml-auto mr-auto font-heading text-left md:hidden w-[90%]">
		SpaceGameDev
		<br/>
		Software
	</h1>

	<SidebarButton title="Home" symbol="home" link="/"/>
	<SidebarButton title="About" symbol="person_book" link="/about" />
	<SidebarButton title="Links" symbol="link" link="/linkinbio" />

	<div class="w-fit ml-auto mr-auto">
		<div class="md:float-left w-[182px] overflow-x-hidden">
			<iframe title="Better Stack Status" src="https://status.spacegamedev.com/badge?theme=dark" id="betterstack-badge" width="250" height="30" loading="eager"></iframe>
		</div>
	</div>

</div>

<script>

	import { animate, scroll } from "motion"

	animate("#header", { y: [-50, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

</script>