---

import SidebarButton from '@components/SidebarButton.astro';

import SidebarToggleButton from '@components/react/SidebarToggleButton.tsx';

const props = Astro.props

import '@styles/global.css';

import HomeIcon from '@assets/images/MaterialIcons/home_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg';
import LinksIcon from '@assets/images/MaterialIcons/link_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg';
import HostingIcon from '@assets/images/MaterialIcons/dns_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg';
import DocsIcon from '@assets/images/MaterialIcons/book_2_24dp_FFFFFF_FILL1_wght400_GRAD0_opsz24.svg';
import DiscordIcon from '@assets/images/Icons/DiscordWhite.svg';

---

<div id="header" class="fixed h-13 bg-[#222225]/50 w-full z-50 backdrop-blur-xs">

	<SidebarToggleButton client:only="react"/>

	<p class="font-heading font-bold text-2xl mt-2 mr-10 ml-auto text-right w-fit text-white float-right invisible md:visible" title="Page Title">{props.pageName}</p>

</div>

<div id="sidebar" class="block fixed h-[calc(100%-3.25rem)] top-13 w-full -left-full md:w-60 md:-left-60  m-0  md:rounded-br-2xl z-50 bg-[#222225]/50 backdrop-blur-xs md:after:w-25 md:after:bg-blue-500" transition:persist>

	<h1 class="text-white font-bold text-2xl ml-auto mr-auto font-heading text-left md:hidden w-[90%]">
		SpaceGameDev
		<br/>
		Modding
	</h1>

	<SidebarButton title="Home" image={HomeIcon} alt="Home" link="/"/>
	<SidebarButton title="Links" image={LinksIcon} alt="Links" link="/linkinbio"/>
	<SidebarButton title="Hosting" image={HostingIcon} alt="Hosting" link="/hosting"/>
	<hr class="border-white/20" />
	<SidebarButton title="Docs" image={DocsIcon} alt="Docs" link="https://docs.spacegamedev.com"/>
	<SidebarButton title="Discord" image={DiscordIcon} alt="Discord" link="/discord"/>

	<div class="w-fit ml-auto mr-auto">
		<div class="md:float-left w-45.5 overflow-x-hidden">
			<iframe title="Better Stack Status" src="https://status.spacegamedev.com/badge?theme=dark" id="betterstack-badge" width="250" height="30" loading="eager"></iframe>
		</div>
	</div>

</div>

<script>

	import { animate } from "motion"

	animate("#header", { y: [-50, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

</script>