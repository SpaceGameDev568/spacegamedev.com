---

import SidebarButton from './SidebarButton.astro';
import SidebarToggleButton from './react/SidebarToggleButton.tsx';

---

<div id="header" class="fixed h-[50px] bg-gray-900 w-full z-50">

	<SidebarToggleButton client:only />

</div>

<!-- <div id="header-spacer" class="h-[50px] mb-10"/> -->

<div id="sidebar" class="block fixed h-[calc(100%-50px)] top-[50px] w-[15rem] left-[-15rem] bg-gray-100 m-0  rounded-br-2xl shadow-2xl z-50 dark:bg-gray-900">

	<SidebarButton title="Home" symbol="home" link="/"/>
	<SidebarButton title="Achievements" symbol="trophy" link="achievements" />
	<SidebarButton title="Gallery" symbol="photo_library" link="gallery" />
	<SidebarButton title="Blog" symbol="wallpaper_slideshow" link="blog" />
	<hr class="dark:border-gray-400"/>
	<SidebarButton title="Links" symbol="link" link="linkinbio" />

</div>