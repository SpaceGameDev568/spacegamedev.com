---

import {Image} from "astro:assets";
const props = Astro.props

---

<a href={props.link} title={props.alt}>

    <Image
            src={props.image}
            alt={props.alt}
            width={props.imageWidth}
            height={props.imageHeight}
            class="w-fit h-auto ml-auto mr-auto"
    />

    <p class="text-center mt-4 mb-4 ml-auto mr-auto text-white w-fit"><b> {props.title} </b></p>

</a>