---

import {Image} from "astro:assets";
const props = Astro.props

import '../styles/components/image-button.scss'

---

<a href={props.link} class="image-button" title={props.alt}>

    <Image
            src={props.image}
            alt={props.alt}
            width={props.imageWidth}
            height={props.imageHeight}
            class="button-thumbnail"
    />

    <p class="title"><b> {props.title} </b></p>

</a>