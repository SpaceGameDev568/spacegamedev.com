---

import {Image} from "astro:assets";
const props = Astro.props

---

<a href={props.link} class="image-button" title={props.alt}>

    <Image
            src={props.image}
            alt={props.alt}
            width={props.imageWidth}
            height={props.imageHeight}
            class="max-w-full h-auto ml-auto mr-auto"
    />

    <p class="text-center m-4"><b> {props.title} </b></p>

</a>