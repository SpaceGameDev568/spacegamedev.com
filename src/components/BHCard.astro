---
import {Image} from "astro:assets";

const props = Astro.props
---

<div class="w-95 m-2  border rounded-2xl border-white/10 bg-[#222225]">

	<div>

		<Image
				src={props.image}
				width="380"
				height="380"
				alt={props.title}
				class="rounded-tl-2xl rounded-tr-2xl"
		/>

	</div>

	<br/>

	<div class="p-5">

		<h1 class="font-bold text-2xl text-blue-500">{props.title}</h1>
		<p class="text-gray-400 text-sm h-10">{props.description}</p>
		<br/>

	</div>
	<br/>
</div>
