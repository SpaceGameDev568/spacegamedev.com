---
import {Image} from "astro:assets";
const props = Astro.props
---

<a
	href={props.link}
	class="flex duration-300 even:bg-background-secondary odd:bg-background-primary hover:bg-spacegamedev-primary text-white p-3 m-auto h-15.5 w-85.5 items-center justify-left shadow-md hover:ring-4 hover:ring-spacegamedev-primary/50 box-border"
    title={props.alt}>

	<Image
			src={props.image}
			alt={props.alt}
			width="32"
			height="32"
			class="mr-2"
	/>

	<div class="justify-self-center">
		<p class="font-bold ml-2"> {props.title} </p>
	</div>
</a>