---
import {Image} from "astro:assets";
import PrimaryActionButton from "./PrimaryActionButton.astro";
import SecondaryActionButton from "./SecondaryActionButton.astro";

const props = Astro.props
---

<div class="w-[380px] m-2  border-[1px] rounded-2xl border-white/10 bg-[#222225]">

	<div>

		<Image
			src={props.image}
			width="380"
			height="380"
			alt={props.title}
			class="rounded-tl-2xl rounded-tr-2xl"
		/>

	</div>

	<br/>

	<div class="p-5">

		<h1 class="font-bold text-2xl text-white">{props.title}</h1>
		<p class="text-gray-400 text-sm h-10">{props.description}</p>
		<br/>

		<hr class="border-white/20 p-5" />

		<div>
			<PrimaryActionButton
				link={props.link}
				title="ficsit.app"
			/>
			&nbsp
			<SecondaryActionButton
				link={props.github}
				title="GitHub"
			/>
		</div>

	</div>
	<br/>
</div>
