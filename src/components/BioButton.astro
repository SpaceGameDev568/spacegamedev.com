---
import {Image} from "astro:assets";
const props = Astro.props
---

<a
	href={props.link}
	class="flex duration-300 bg-white hover:border-black hover:border-[1px] p-2 rounded-2xl m-1 ml-auto mr-auto h-[62px] w-[342px] items-center justify-left shadow-[rgba(0, 0, 0, 0.2)] shadow-md mt-5"
    title={props.alt}>

	<Image
			src={props.image}
			alt={props.alt}
			width="32"
			height="32"
			class="mr-2"
	/>

	<div class="justify-self-center width-[calc(100% + 32px)]">
		<p class="font-bold text-black"> {props.title} </p>
	</div>
</a>