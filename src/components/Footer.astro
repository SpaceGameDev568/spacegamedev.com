---
import {Image} from "astro:assets";

import flag from "../../public/images/Flag_of_the_United_States_Wikipedia.svg"

import bisectBanner from "../../public/images/BisectBanner.webp";
import BHLogomark from "../../public/images/BisectHostingLogomark.svg";
---

<div id="footer" class="bg-[#222225] p-10 mt-10 border-white/10 border-t-[1px] border-b-[1px]">

	<Image
	src={flag}
	alt="American Flag"
	height="50"
	width="100"
	class="float-left mr-5 mb-5"
	/>

	<p class="text-white w-fit float-left">Copyright © 2022 - 2026 Jesse Hodgson. Licensed MIT.

		<br/>

		Performance and security by Cloudflare.

		<br/>

		Source code available on <a href="https://github.com/SpaceGameDev568/spacegamedev.com" class="text-blue-500 hover:text-blue-300 duration-300">GitHub</a>.

		<br/><br/>

		In God We Trust

		<br/><br/>

	</p>


	<div class="md:float-right w-fit">

		<div class="w-[182px] overflow-x-hidden md:mr-0 md:ml-auto">
			<iframe title="Better Stack Status" src="https://status.spacegamedev.com/badge?theme=dark" id="betterstack-badge" width="250" height="30" loading="lazy"></iframe>
		</div>

		<br/>

		<div class="w-fit md:mr-0 md:ml-auto">

			<a target="_blank" href="https://uptime.betterstack.com">
				<Image
						src="https://uptime.betterstack.com/assets/static_assets/badges/light.png"
						id="betterstack-attribution"
						width="130"
						height="52"
						alt="Better Stack Website Monitoring"
				/>
			</a>

		</div>

		<br/>

		<hr class="border-white/10"/>

		<br/>

		<a href="https://bisecthosting.com/spacegamedev?r=WebsiteFooter" class="flex items-center justify-center w-fit no-underline md:mr-0 md:ml-auto ml-0 mr-auto">
			<div>
				<p class="text-white md:text-right text-xl">Need a game server?</p>
				<p class="text-white md:text-right">Use code "SPACEGAMEDEV" for 25% off your first month!</p>
			</div>
			<Image
					src={BHLogomark}
					alt="BisectHosting"
					width="64"
					height="64"
					loading="eager"
					class="ml-2"
			/>

		</a>
	</div>

	<div class="hidden md:block">

		<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>

	</div>
</div>