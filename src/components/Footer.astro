---
import "../styles/components/footer.scss";
import {Image} from "astro:assets";
import spaceGameDevLogo from '../../public/images/TripleSevenLogoJHAviation.png';
---
<section class="footer">



    <br>



            <br/>

            <small> Copyright 2022 - 2024 Jesse Hodgson. All Rights Reserved. </small>

        <a class="betterstack-attribution" target="_blank" href="https://uptime.betterstack.com">
            <Image
                    src="https://uptime.betterstack.com/assets/static_assets/badges/light.png"
                    id="betterstack-attribution"
                    width="130"
                    height="52"
                    alt="Better Stack Website Monitoring"
                />
        </a>

    <script>
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.getElementById("betterstack-attribution").src = "https://uptime.betterstack.com/assets/static_assets/badges/dark.png";
        }
    </script>

</section>
