---
import {Image} from "astro:assets";

import flag from "../../public/images/Flag_of_the_United_States_Wikipedia.svg"
---

<div id="footer" class="bg-[#222225] p-10 mt-10 border-opacity-10 border-white border-t-[1px]">

	<Image
	src={flag}
	alt="American Flag"
	height="50"
	width="100"
	class="float-left mr-5 mb-5"
	/>

	<p class="text-white w-fit float-left">Copyright © 2022 - 2025 Jesse Hodgson. All Rights Reserved.

		<br/>

		Performance and security by Cloudflare.

	</p>

	<div class="md:float-right w-[182px] overflow-x-hidden">
		<iframe title="Better Stack Status" src="https://status.spacegamedev.com/badge?theme=dark" id="betterstack-badge" width="250" height="30" loading="lazy"></iframe>
	</div>

	<br/><br/><br/><br/>

	<div class="w-fit">

		<a target="_blank" href="https://uptime.betterstack.com">
			<Image
					src="https://uptime.betterstack.com/assets/static_assets/badges/light.png"
					id="betterstack-attribution"
					width="130"
					height="52"
					alt="Better Stack Website Monitoring"
			/>
		</a>

	</div>
</div>