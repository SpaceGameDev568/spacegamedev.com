---
const { title, url, description, date } = Astro.props
---
<a href={url}>
	<li class="w-100 aspect-video bg-background-primary p-5 hover:bg-spacegamedev-primary duration-300 border border-white/10 m-2">

			<p class="text-white">{title}</p>
			<p class="text-blue-500">{date}</p>
			<p class="text-gray-400 text-sm h-10">{description}</p>

	</li>
</a>
