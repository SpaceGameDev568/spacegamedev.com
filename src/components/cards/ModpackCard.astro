---
import {Image} from "astro:assets";
import PrimaryActionButton from "@components/PrimaryActionButton.astro";
import SecondaryActionButton from "@components/SecondaryActionButton.astro";

const props = Astro.props
---

<div class="w-95 m-2 border border-white/10 bg-background-primary">
	
	<div>

		<Image
			src={props.image}
			width="380"
			height="380"
			alt={props.title}
			class="border-b border-white/10"
		/>

	</div>

	<br/>

	<div class="p-5">

		<h1 class="font-bold font-heading text-2xl text-white">{props.title}</h1>
		<p class="text-gray-400 text-sm h-10">{props.description}</p>
		<br/>

		<hr class="border-white/20 p-5" />

		<div>
			<PrimaryActionButton
				link={props.link}
				title="Modrinth"
			/>
			&nbsp
			<SecondaryActionButton
				link={props.github}
				title="GitHub"
			/>
		</div>

	</div>
	<br/>
</div>
