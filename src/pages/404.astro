---
import Layout from "../layouts/Layout.astro";
import PrimaryActionButton from "../components/PrimaryActionButton.astro";
---


<Layout title="SpaceGameDev / 404 :(">

	<div id="header-spacer" class="h-[50px] mb-10"/>

	<div>

		<p class="font-bold leading-tight font-heading text-[25vw] ml-auto mr-auto w-fit text-center bg-clip-text text-transparent bg-[linear-gradient(60deg,_rgb(247,_149,_51),_rgb(243,_112,_85),_rgb(239,_78,_123),_rgb(161,_102,_171),_rgb(80,_115,_184),_rgb(16,_152,_173),_rgb(7,_179,_155),_rgb(111,_186,_130))]">404</p>

		<p class="font-bold text-4xl font-heading ml-auto mr-auto w-fit text-center bg-clip-text text-transparent bg-[linear-gradient(60deg,_rgb(247,_149,_51),_rgb(243,_112,_85),_rgb(239,_78,_123),_rgb(161,_102,_171),_rgb(80,_115,_184),_rgb(16,_152,_173),_rgb(7,_179,_155),_rgb(111,_186,_130))]"> The cake is a lie. </p>

		<br/>

		<p class="ml-auto mr-auto w-fit text-center text-white">
			Sorry, that page could not be found.<br>
			Would you like to return to the home page?
		</p>

		<br/>

		<div class="ml-auto mr-auto w-fit">

			<PrimaryActionButton
					link="/"
					title="Home"
			/>

		</div>

	</div>

</Layout>