---
import Layout from "@layouts/Layout.astro";
import PrimaryActionButton from "@components/PrimaryActionButton.astro";
---


<Layout title="SpaceGameDev / 404 :(">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<div>

		<p class="font-bold leading-tight font-heading text-[25vw] ml-auto mr-auto w-fit text-center bg-clip-text text-transparent bg-[linear-gradient(60deg,rgb(247,149,51),rgb(243,112,85),rgb(239,78,123),rgb(161,102,171),rgb(80,115,184),rgb(16,152,173),rgb(7,179,155),rgb(111,186,130))]">404</p>

		<p class="font-bold text-4xl font-heading ml-auto mr-auto w-fit text-center bg-clip-text text-transparent bg-[linear-gradient(60deg,rgb(247,149,51),rgb(243,112,85),rgb(239,78,123),rgb(161,102,171),rgb(80,115,184),rgb(16,152,173),rgb(7,179,155),rgb(111,186,130))]"> The cake is a lie. </p>

		<br/>

		<p class="ml-auto mr-auto w-fit text-center text-white">
			Sorry, that page could not be found.<br>
			Would you like to return to the home page?
		</p>

		<br/>
		<br/>

		<div class="ml-auto mr-auto w-fit">

			<PrimaryActionButton
					link="/"
					title="Home"
