---

import Layout from '@layouts/Layout.astro';

import BlogPostCard from "@components/cards/BlogPostCard.astro";

const allPosts = Object.values(
	import.meta.glob("./posts/*.md", { eager: true })
).sort((a:any, b:any) => {
	// Sort descending (newest first)
	const dateA = new Date(a.frontmatter.pubDate).valueOf();
	const dateB = new Date(b.frontmatter.pubDate).valueOf();

	return dateB - dateA; // Descending
});

---

<Layout title="SpaceGameDev / Blog">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Personal Blog </h1>

	<br/>
	<br/>

	<ul class="ml-auto mr-auto w-fit flex flex-wrap place-content-center">
		{allPosts.map((post:any) => <BlogPostCard url={post.url} title={post.frontmatter.title} date={post.frontmatter.pubDate} description={post.frontmatter.description} />)}
	</ul>

</Layout>