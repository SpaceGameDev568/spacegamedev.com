---

import Layout from '@layouts/Layout.astro';
import { getCollection } from "astro:content";

import BlogPostCard from "@components/cards/BlogPostCard.astro";

const allPosts = (await getCollection("blog")).sort((a:any, b:any) => {
	// Sort descending (newest first)
	const dateA = new Date(a.data.pubDate).valueOf();
	const dateB = new Date(b.data.pubDate).valueOf();

	return dateB - dateA; // Descending
});

---

<Layout title="SpaceGameDev / Blog">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<h1 class="text-5xl font-bold m-auto w-fit text-white font-heading text-center"> Personal Blog </h1>

	<br/>
	<br/>

	<ul class="m-auto w-fit flex flex-wrap place-content-center">
		{
			allPosts.map((post:any) => (
				<BlogPostCard url={`/posts/${post.id}/`} title={post.data.title} date={post.data.pubDate.toLocaleDateString("en-US")} description={post.data.description} />
		))
		}
	</ul>

</Layout>