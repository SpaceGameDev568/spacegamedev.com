---

import {Image} from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import ModCard from '../components/ModCard.astro'
import ProjectCard from "../components/ProjectCard.astro";
import ModpackCard from "../components/ModpackCard.astro";

import SpaceGameDevLogo from '../../public/images/FilledAvatar.svg';
import PrimaryActionButton from "../components/PrimaryActionButton.astro";
import SecondaryActionButton from "../components/SecondaryActionButton.astro";

import SatisfactoryLogo from "../../public/images/SatisfactoryLogo.webp"
import MinecraftLogo from "../../public/images/MinecraftLogo.svg";

import BetterGrassLogo from "../../public/images/ModLogos/BetterGrass.png";
import DiscordRichPresenceLogo from "../../public/images/ModLogos/DiscordRichPresence.png";
import FactoryPropsLogo from "../../public/images/ModLogos/FactoryProps.png";
import ModUpdateNotifierLogo from "../../public/images/ModLogos/ModUpdateNotifier.png";
import MorePlayersLogo from "../../public/images/ModLogos/MorePlayers.png";
import RemoveAllAnnoyancesLogo from "../../public/images/ModLogos/RemoveAllAnnoyances.png";
import SatisWHACKtoryLogo from "../../public/images/ModLogos/SatisWHACKtory.png";
import TwoMeterWallsLogo from "../../public/images/ModLogos/TwoMeterWalls.png";
import IECLogo from "../../public/images/ModLogos/IEC.png";
import RagdollOnDemandLogo from "../../public/images/ModLogos/RagdollOnDemand.png";
import PropPioneerLogo from "../../public/images/ModLogos/PropPioneer.png";
import KuvankaunisLogo from "../../public/images/ModLogos/Kuvankaunis.png";
import SnapAxisLogo from "../../public/images/SnapAxisProjectThumbnail.svg";


---

<Layout title="SpaceGameDev / Home">

	<div id="header-spacer" class="h-[50px] mb-10"/>

	<div class="ml-auto mr-auto w-[90%] md:w-[80%]">

		<div class="2xl:h-[550px] lg:h-[750px] md:h-[580px]">

			<Image
				src={SpaceGameDevLogo}
				alt="SpaceGameDev"
				width="120"
				height="120"
				class="rounded-2xl md:ml-0  ml-auto mr-auto 2xl:hidden -mt-[150px]"
				id="mobile-header-image"
				loading="eager"
			/>

			<div id="fpm-heading" class="leading-3 lg:w-[60%] lg:float-left lg:absolute">

				<h1 class="font-heading font-bold text-white lg:text-8xl text-4xl">SpaceGameDev<br/>Modding</h1><br/>
				<h2 class="text-blue-500 lg:text-4xl text-3xl"> Open Source modding for everyone </h2><br/>
				<p class="text-white text-2xl bg-[#101014]/25 rounded-2xl md:w-[60%] p-2">
					The home of mods like Factory Props and Mod Update Notifier for Satisfactory, and modpacks like Kuvankaunis for Minecraft.
				</p>

				<br/><br/><br/><br/>

				<SecondaryActionButton
						link="#satisfactory-mods"
						title="Learn More"
				/>

				&nbsp

				<PrimaryActionButton
						link="/hosting"
						title="Server Hosting"
				/>



				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>

			</div>

			<script>
				import { animate } from "motion"

				document.addEventListener('astro:page-load', () => {
					animate("#fpm-heading", { y: [400, 175], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

					animate("#mobile-header-image", { y: [400, 150], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
				});
			</script>

			<Image
				src={SpaceGameDevLogo}
				alt="SpaceGameDev"
				width="512"
				height="512"
				loading="eager"
				class="rounded-2xl lg:ml-auto lg:mr-0 2xl:block hidden"
			/>

		</div>

		<div id="satisfactory-mods"/>

		<br/><br/><br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Mods for </h1>

		<br/>

		<Image
				src={SatisfactoryLogo}
				alt="Satisfactory"
				width="512"
				height="512"
				loading="eager"
				class="ml-auto mr-auto"
		/>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ModCard
					title="Factory Props"
					description="The Ultimate Decorating Toolkit!"
					image={FactoryPropsLogo}
					link="https://ficsit.app/mod/Factory_Prop_Mod"
					github="https://github.com/SpaceGameDev568/Factory_Prop_Mod"
			/>

			<ModCard
					title="Discord Rich Presence"
					description="Show off your Satisfactory presence info on your Discord profile!"
					image={DiscordRichPresenceLogo}
					link="https://ficsit.app/mod/FG_DiscordRP"
					github="https://github.com/SpaceGameDev568/FG_DiscordRP"
			/>

			<ModCard
					title="Remove All Annoyances"
					description="Removes annoying things from the world."
					image={RemoveAllAnnoyancesLogo}
					link="https://ficsit.app/mod/RemoveAllAnnoyances"
					github="https://github.com/SpaceGameDev568/RemoveAllAnnoyances"
			/>

			<ModCard
					title="Better Grass"
					description="More beautiful grass for your game."
					image={BetterGrassLogo}
					link="https://ficsit.app/mod/BetterGrass"
					github="https://github.com/SpaceGameDev568/BetterGrass"
			/>

			<ModCard
					title="SatisWHACKtory"
					description="FICSIT Inc. is not responsible for any injuries caused by the use of this mod."
					image={SatisWHACKtoryLogo}
					link="https://ficsit.app/mod/ObstacleMod"
					github="https://github.com/SpaceGameDev568/ObstacleMod"
			/>

			<ModCard
					title="Mod Update Notifier"
					description="This mod will notify you whenever a supported mod has an update available!"
					image={ModUpdateNotifierLogo}
					link="https://ficsit.app/mod/ModUpdateNotifier"
					github="https://github.com/SpaceGameDev568/ModUpdateNotifier"
			/>

			<ModCard
					title="2m Walls"
					description="2m high walls for the extra efficient builder."
					image={TwoMeterWallsLogo}
					link="https://ficsit.app/mod/TwoMeterWalls"
					github="https://github.com/SpaceGameDev568/TwoMeterWalls"
			/>

			<ModCard
					title="More Players"
					description="Allows you to have more than just 4 people in your game."
					image={MorePlayersLogo}
					link="https://ficsit.app/mod/MorePlayers"
					github="https://github.com/SpaceGameDev568/MorePlayers"
			/>

			<ModCard
					title="Improved Explorer Cameras"
					description="Improved camera modes for the explorer."
					image={IECLogo}
					link="https://ficsit.app/mod/4rQKCVojbp93or"
					github="https://github.com/SpaceGameDev568/ImprovedExplorerCameras"
			/>

			<ModCard
					title="Ragdoll On Demand"
					description="Brings back the ragdoll-on-keypress feature from the alpha"
					image={RagdollOnDemandLogo}
					link="https://ficsit.app/mod/RagdollOnDemand"
					github="https://github.com/SpaceGameDev568/RagdollOnDemand"
			/>

			<ModCard
					title="Prop Pioneer"
					description="A buildable Pioneer prop that you can customize and pose!"
					image={PropPioneerLogo}
					link="https://ficsit.app/mod/PropPioneer"
					github="https://github.com/SpaceGameDev568/PropPioneer"
			/>

		</div>

		<br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Modpacks for </h1>

		<br/>

		<Image
				src={MinecraftLogo}
				alt="Minecraft"
				width="512"
				height="512"
				loading="eager"
				class="ml-auto mr-auto"
		/>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ModpackCard
					title="Kuvankaunis"
					description="A modern Minecraft modpack focused on visuals and exploration."
					image={KuvankaunisLogo}
					link="https://modrinth.com/modpack/kuvankaunis"
					github="https://github.com/SpaceGameDev568/Kuvankaunis"
			/>

		</div>

		<br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Partner Projects </h1>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ProjectCard
					title="SnapAxis"
					description="Play With Precision."
					image={SnapAxisLogo}
					link="https://snapaxis.net"
					github="https://github.com/DREAMTEAM-WAVE-MAKERS/snapaxisLAUNCHpad"
			/>

		</div>

	</div>

</Layout>