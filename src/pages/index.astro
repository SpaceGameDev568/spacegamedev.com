---

import {Image} from 'astro:assets';

import Layout from '@layouts/Layout.astro';
import ProjectCard from '../components/cards/ProjectCard.astro'

import ActionButton from "../components/buttons/ActionButton.astro";

import SatisfactoryLogo from "@assets/images/SatisfactoryLogo.webp"
import MinecraftLogo from "@assets/images/MinecraftLogo.svg";

import BetterGrassLogo from "@assets/images/ModLogos/BetterGrass.png";
import DiscordRichPresenceLogo from "@assets/images/ModLogos/DiscordRichPresence.png";
import FactoryPropsLogo from "@assets/images/ModLogos/FactoryProps.png";
import ModUpdateNotifierLogo from "@assets/images/ModLogos/ModUpdateNotifier.png";
import RemoveAllAnnoyancesLogo from "@assets/images/ModLogos/RemoveAllAnnoyances.png";
import SatisWHACKtoryLogo from "@assets/images/ModLogos/SatisWHACKtory.png";
import TwoMeterWallsLogo from "@assets/images/ModLogos/TwoMeterWalls.png";
import IECLogo from "@assets/images/ModLogos/ImprovedExplorerCameras.png";
import RagdollOnDemandLogo from "@assets/images/ModLogos/RagdollOnDemand.png";
import PropPioneerLogo from "@assets/images/ModLogos/PropPioneer.png";
import FactoryCartStationLogo from "@assets/images/ModLogos/FactoryCartStation.png";
import CoffeeCupAddonsLogo from "@assets/images/ModLogos/CoffeeCupAddons.png";
import KuvankaunisLogo from "@assets/images/ModLogos/Kuvankaunis.png";
import SnapAxisLogo from "@assets/images/SnapAxisProjectThumbnail.svg";
import ZLANLogo from "@assets/images/ZLANLogo.svg";
import VerseOfTheDayWrapper from "@components/VerseOfTheDayWrapper.astro";


---

<Layout title="SpaceGameDev / Home">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<div class="ml-auto mr-auto w-[90%] md:w-[80%]">

		<div class="2xl:h-137.5 lg:h-187.5 md:h-145">

			<img
				src="/images/Favicon.svg"
				alt="SpaceGameDev"
				width="120"
				height="120"
				class="md:ml-0 mr-auto 2xl:hidden mt-12.5 mb-5"
				id="mobile-header-image"
				loading="eager"
			/>

			<div id="fpm-heading" class="leading-3 lg:w-[60%] lg:float-left lg:absolute mt-12.5">

				<h1 class="font-heading font-bold text-white lg:text-8xl text-4xl">SpaceGameDev<br/>Modding</h1><br/>
				<h2 class="animate-rgb-cycle lg:text-4xl text-3xl"> Open Source modding for everyone </h2><br/>
				<p class="text-white text-2xl bg-[#101014]/25 md:w-[60%] p-2">
					The home of mods like Factory Props and Mod Update Notifier for Satisfactory, and modpacks like Kuvankaunis for Minecraft.
				</p>

				<br/><br/><br/><br/>

				<div class="flex gap-2">

					<ActionButton
							link="/hosting"
							title="Server Hosting"
							variant="secondary"
							target="_self"
					/>

					<ActionButton
							link="/blog"
							title="Blog"
							variant="secondary"
							target="_self"
					/>

					<ActionButton
							link="#satisfactory-mods"
							title="Projects"
							variant="primary"
							target="_self"
					/>

				</div>



				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>

			</div>


			<!--<script>
				import { animate } from "motion"

				document.addEventListener('astro:page-load', () => {
					animate("#fpm-heading", { y: [400, 175], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

					animate("#mobile-header-image", { y: [400, 150], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
				});
			</script>
			-->

			<img
				src="/images/Favicon.svg"
				alt="SpaceGameDev"
				width="512"
				height="512"
				loading="eager"
				class="lg:ml-auto lg:mr-0 2xl:block hidden"
			/>

		</div>

		<br/><br/><br/><br/>

		<VerseOfTheDayWrapper/>

		<div id="satisfactory-mods"/>

		<br/><br/><br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Mods for </h1>

		<br/>

		<Image
				src={SatisfactoryLogo}
				alt="RGBSatisfactory"
				width="512"
				loading="eager"
				class="ml-auto mr-auto"
		/>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ProjectCard
					title="Factory Props"
					description="The Ultimate Decorating Toolkit!"
					image={FactoryPropsLogo}
					link="https://ficsit.app/mod/Factory_Prop_Mod"
					github="https://github.com/SpaceGameDev568/Factory_Prop_Mod"
			/>

			<ProjectCard
					title="Mod Update Notifier"
					description="This mod will notify you whenever a supported mod has an update available!"
					image={ModUpdateNotifierLogo}
					link="https://ficsit.app/mod/ModUpdateNotifier"
					github="https://github.com/SpaceGameDev568/ModUpdateNotifier"
			/>


			<ProjectCard
					title="Discord Rich Presence"
					description="Show off your Satisfactory presence info on your Discord profile!"
					image={DiscordRichPresenceLogo}
					link="https://ficsit.app/mod/FG_DiscordRP"
					github="https://github.com/SpaceGameDev568/FG_DiscordRP"
			/>

			<ProjectCard
					title="Prop Pioneer"
					description="A buildable Pioneer prop that you can customize and pose!"
					image={PropPioneerLogo}
					link="https://ficsit.app/mod/PropPioneer"
					github="https://github.com/SpaceGameDev568/PropPioneer"
			/>

			<ProjectCard
					title="Factory Cart Station"
					description="A docking station for your Factory Carts!"
					image={FactoryCartStationLogo}
					link="https://ficsit.app/mod/FactoryCartStation"
					github="https://github.com/SpaceGameDev568/FactoryCartStation"
			/>

			<ProjectCard
					title="Improved Explorer Cameras"
					description="Improved camera modes for the explorer."
					image={IECLogo}
					link="https://ficsit.app/mod/4rQKCVojbp93or"
					github="https://github.com/SpaceGameDev568/ImprovedExplorerCameras"
			/>

			<ProjectCard
					title="Remove All Annoyances"
					description="Removes annoying things from the world."
					image={RemoveAllAnnoyancesLogo}
					link="https://ficsit.app/mod/RemoveAllAnnoyances"
					github="https://github.com/SpaceGameDev568/RemoveAllAnnoyances"
			/>

			<ProjectCard
					title="Better Grass"
					description="More beautiful grass for your game."
					image={BetterGrassLogo}
					link="https://ficsit.app/mod/BetterGrass"
					github="https://github.com/SpaceGameDev568/BetterGrass"
			/>

			<ProjectCard
					title="Ragdoll On Demand"
					description="Brings back the ragdoll-on-keypress feature from the alpha"
					image={RagdollOnDemandLogo}
					link="https://ficsit.app/mod/RagdollOnDemand"
					github="https://github.com/SpaceGameDev568/RagdollOnDemand"
			/>

			<ProjectCard
					title="SatisWHACKtory"
					description="FICSIT Inc. is not responsible for any injuries caused by the use of this mod."
					image={SatisWHACKtoryLogo}
					link="https://ficsit.app/mod/ObstacleMod"
					github="https://github.com/SpaceGameDev568/ObstacleMod"
			/>

			<ProjectCard
					title="2m Walls"
					description="2m high walls for the extra efficient builder."
					image={TwoMeterWallsLogo}
					link="https://ficsit.app/mod/TwoMeterWalls"
					github="https://github.com/SpaceGameDev568/TwoMeterWalls"
			/>

			<ProjectCard
					title="Coffee Cup Addons"
					description="Addons for Coffee Cup Studios events, such as the Coffee Cup Cup."
					image={CoffeeCupAddonsLogo}
					link="https://ficsit.app/mod/CoffeeCupAddons"
					github="https://github.com/SpaceGameDev568/CoffeeCupAddons"
			/>

		</div>

		<br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Modpacks for </h1>

		<br/>

		<Image
				src={MinecraftLogo}
				alt="Minecraft"
				width="512"
				height="512"
				loading="eager"
				class="ml-auto mr-auto"
		/>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ProjectCard
					title="Kuvankaunis"
					description="A modern Minecraft modpack focused on visuals and exploration."
					image={KuvankaunisLogo}
					link="https://modrinth.com/modpack/kuvankaunis"
					github="https://github.com/SpaceGameDev568/Kuvankaunis"
					variant="Modpack"
			/>

		</div>

		<br/><br/>

		<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Partner Projects </h1>

		<br/><br/>

		<div class="flex flex-wrap place-content-center">

			<ProjectCard
					title="ZLAN 2026 (Satisfactory Mod)"
					description="Worked on the mod that made Satisfactory at ZLAN 2026 possible!"
					image={ZLANLogo}
					link="https://zlan.fr"
					github="https://github.com/Panakotta00/ZLAN-Satisfactory"
					variant="Project"
			/>

			<ProjectCard
					title="SnapAxis"
					description="Play With Precision."
					image={SnapAxisLogo}
					link="https://snapaxis.net"
					github="https://github.com/DREAMTEAM-WAVE-MAKERS/snapaxisLAUNCHpad"
					variant="Project"
			/>

		</div>

	</div>

</Layout>