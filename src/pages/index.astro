---

import {Image} from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import ModCard from '../components/ModCard.astro'
import ContactForm from '../components/react/ContactForm';

import profilePicture from '../../public/images/ProfilePicture.webp';
import bisectBanner from "../../public/images/Bisect2.webp";
import FPMHero from '../../public/images/Screenshot20250122-10513200000.png';
import PrimaryActionButton from "../components/PrimaryActionButton.astro";
import SecondaryActionButton from "../components/SecondaryActionButton.astro";

import BetterGrassLogo from "../../public/images/ModLogos/BetterGrass.png";
import DiscordRichPresenceLogo from "../../public/images/ModLogos/DiscordRichPresence.png";
import FactoryPropsLogo from "../../public/images/ModLogos/FactoryProps.png";
import ModUpdateNotifierLogo from "../../public/images/ModLogos/ModUpdateNotifier.png";
import MorePlayersLogo from "../../public/images/ModLogos/MorePlayers.png";
import RemoveAllAnnoyancesLogo from "../../public/images/ModLogos/RemoveAllAnnoyances.png";
import SatisWHACKtoryLogo from "../../public/images/ModLogos/SatisWHACKtory.png";
import TwoMeterWallsLogo from "../../public/images/ModLogos/TwoMeterWalls.png";

---

<Layout title="SpaceGameDev / Home">

	<div class="ml-auto mr-auto w-[90%] md:w-[80%]">

		<div class="2xl:h-[550px] lg:h-[1024px]">

			<Image
				src={FPMHero}
				alt="Factory Props"
				width="900"
				height="500"
				class="rounded-2xl aspect-video lg:ml-auto lg:mr-0 shadow-[0px_0px_100px_-15px_#66a2a1] 2xl:hidden -mt-[150px]"
				id="mobile-header-image"
				loading="eager"
			/>

			<div id="fpm-heading" class="leading-3 lg:w-[60%] lg:float-left lg:absolute">

				<h1 class="font-heading font-bold text-white lg:text-8xl text-5xl">Factory Props</h1><br/>
				<h2 class="font-heading text-white  text-4xl"> Your Ultimate Decorating Toolkit.</h2><br/>
				<p class="text-white text-2xl bg-[#101014] bg-opacity-25 rounded-2xl md:w-[60%]">
					Factory Props is a mod for Satisfactory created to give you all the options in the world (literally) when decorating your factories!
				</p>

				<br/><br/><br/><br/>

				<PrimaryActionButton
					link="https://ficsit.app/mod/Factory_Prop_Mod"
					title="Learn More"
				/>

				&nbsp

				<SecondaryActionButton
					link="#satisfactory-mods"
					title="Discover Mods"
				/>

				<br/><br/>
				<br/><br/>
				<br/><br/>
				<br/><br/>

			</div>

			<script>
				import { animate, scroll } from "motion"

				document.addEventListener('astro:page-load', () => {
					animate("#fpm-heading", { y: [400, 100], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )

					animate("#mobile-header-image", { y: [400, 150], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
				});
			</script>

			<Image
				src={FPMHero}
				alt="Factory Props"
				width="900"
				height="500"
				loading="eager"
				class="rounded-2xl aspect-video lg:ml-auto lg:mr-0 shadow-[0px_0px_100px_-15px_#66a2a1] lg:w-[900px] w-[500px] 2xl:block hidden"
			/>

		</div>

		<br/><br/><br/><br/>

		<div class="border-[1px] border-opacity-10 rounded-2xl border-white bg-[#222225] box-border p-5">
			<div class="float-left">
				<h1 class="text-white lg:text-5xl text-3xl font-heading font-bold">SpaceGameDev Software</h1><br/>
				<p class="text-white">I'm SpaceGameDev, and I make Factory Props and other mods for Satisfactory!</p>
				<br/>
				<PrimaryActionButton
					link="about"
					title="About Me"
				/>
				<br/>
				<br/>
				<br/>
			</div>

			<Image
				src={profilePicture}
				alt="Me with a plane flying overhead"
				width="256"
				height="256"
				class="rounded-2xl aspect-square mr-auto w-fit ml-auto md:mr-0"
			/>
		</div>

		<br/><br/>

		<div class="border-[1px] border-opacity-10 rounded-2xl border-white bg-[#222225] box-border p-5">
			<div class="xl:float-left xl:w-[49%]">
				<h1 class="text-white lg:text-5xl text-3xl font-heading font-bold">Bisect Hosting</h1><br/>
				<p class="text-white">
					If you're looking to host a Satisfactory (or another game) server capable of running mods, I encourage you to check out BisectHosting!
					<br/><br/>
					I've partnered with BisectHosting so you can get a fast, reliable, and modding-capable server at a discounted price with my promo code. Use code spacegamedev for 25% off your first month for new customers!
				</p>
				<br/>
				<PrimaryActionButton
						link="https://bisecthosting.com/spacegamedev"
						title="Get Started"
				/>
				<br/><br/>
			</div>

			<a href="https://bisecthosting.com/spacegamedev">

				<Image
						src={bisectBanner}
						alt="Bisect Hosting: Get 25% off your first month when you use code spacegamedev. 8 Gigabytes recommended."
						width="512"
						height="314"
						class="rounded-2xl ml-auto mr-auto xl:mt-auto xl:mr-0 xl:w-[49%] md:max-w-[512px]"
				/>

			</a>

		</div>

	</div>

	<div id="satisfactory-mods"/>

	<br/><br/><br/><br/>

	<hr class="border-white border-opacity-20" />

	<br/>

	<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading text-center"> Satisfactory Mods </h1>

	<br/><br/>

	<div class="flex flex-wrap place-content-center">

		<ModCard
				title="Factory Props"
				description="The Ultimate Decorating Toolkit!"
				image={FactoryPropsLogo}
				link="https://ficsit.app/mod/Factory_Prop_Mod"
				github="https://github.com/SpaceGameDev568/Factory_Prop_Mod"
		/>

		<ModCard
				title="Discord Rich Presence"
				description="Show off your Satisfactory presence info on your Discord profile!"
				image={DiscordRichPresenceLogo}
				link="https://ficsit.app/mod/FG_DiscordRP"
				github="https://github.com/SpaceGameDev568/FG_DiscordRP"
		/>

		<ModCard
				title="Remove All Annoyances"
				description="Removes annoying things from the world."
				image={RemoveAllAnnoyancesLogo}
				link="https://ficsit.app/mod/RemoveAllAnnoyances"
				github="https://github.com/SpaceGameDev568/RemoveAllAnnoyances"
		/>

		<ModCard
				title="Better Grass"
				description="More beautiful grass for your game."
				image={BetterGrassLogo}
				link="https://ficsit.app/mod/BetterGrass"
				github="https://github.com/SpaceGameDev568/BetterGrass"
		/>

		<ModCard
				title="SatisWHACKtory"
				description="FICSIT Inc. is not responsible for any injuries caused by the use of this mod."
				image={SatisWHACKtoryLogo}
				link="https://ficsit.app/mod/ObstacleMod"
				github="https://github.com/SpaceGameDev568/ObstacleMod"
		/>

		<ModCard
				title="Mod Update Notifier"
				description="This mod will notify you whenever a supported mod has an update available!"
				image={ModUpdateNotifierLogo}
				link="https://ficsit.app/mod/ModUpdateNotifier"
				github="https://github.com/SpaceGameDev568/ModUpdateNotifier"
		/>

		<ModCard
				title="2m Walls"
				description="2m high walls for the extra efficient builder."
				image={TwoMeterWallsLogo}
				link="https://ficsit.app/mod/TwoMeterWalls"
				github="https://github.com/SpaceGameDev568/TwoMeterWalls"
		/>

		<ModCard
				title="More Players"
				description="Allows you to have more than just 4 people in your game."
				image={MorePlayersLogo}
				link="https://ficsit.app/mod/MorePlayers"
				github="https://github.com/SpaceGameDev568/MorePlayers"
		/>

	</div>

	<br/><br/>

	<hr class="border-white border-opacity-20"/>

	<br/><br/>

	<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-white font-heading"> Get In Touch </h1>

	<br/>

	<ContactForm client:only/>

</Layout>