---
import Layout from '../layouts/Layout.astro';
import {Image} from 'astro:assets';

import profilePicture from '../../public/images/ProfilePicture.webp';
import ModCard from '../components/ModCard.astro'
import ContactForm from '../components/react/ContactForm';

import ModdingHeader from '../../public/images/FactoryProps1.webp'
---

<Layout title="SpaceGameDev / Home">

	<div class="bg-gradient-to-r from-violet-100 to-indigo-100 dark:bg-gradient-to-r dark:from-violet-900 dark:to-indigo-900 m-10 rounded-2xl">

		<div class="h-[256px] w-fit ml-auto mr-0">
			<Image
					src={profilePicture}
					alt="me"
					width="256"
					height="256"
					class="rounded-2xl float-right mr-10 mt-10"
					loading="eager"
			/>
		</div>

			<h1 id="heading-text-animated" class="text-6xl font-bold text-black dark:text-white font-heading z-10 ml-10  underline decoration-blue-500 drop-shadow-lg"> SPACEGAMEDEV</h1>
			<br/>
			<h2 id="heading-text-animated-2" class="absoulte text-black dark:text-white z-10 ml-10">Space Nerd, AvGeek, and Software Developer</h2>

	</div>

	<br/><br/>

	<script>

		import { animate, scroll } from "motion"

		animate("#heading-text-animated", { y: [-300, -200], opacity: [0, 100] }, { ease: "easeInOut", duration: 2 } )
		animate("#heading-text-animated-2", { y: [-300, -200], opacity: [0, 100] }, { ease: "easeInOut", duration: 2.5 } )

	</script>


	<p class="text-black dark:text-white ml-40 mr-40 text-lg">
		Hey, I'm Jesse!
		My nickname, "SpaceGameDev", is derived from my love of everything related to Spaceflight, and my passion
		for Software Development and Video Games.

		<br/><br/>

		Starting my professional journey with Software Development and IT in 2021, I created my first mod for
		Satisfactory, called "Factory Props".
		Since then I have significantly increased my expertise through both first-hand experience and online
		resources.
		In Fall 2023, I obtained my IT Support Certificate from Google.
		Since then, I've been learning as much as I can, and helping friends and family with tech issues.

		<br/><br/>

		I've taken up photography more recently, and since I already love to go planespotting at my local airport, I
		take lots of plane photos there.
	</p>

	<br/><br/><br/><br/>

	<hr class="border-black dark:border-white border-opacity-20 dark:border-opacity-20"/>

	<br/>

	<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-black dark:text-white font-heading"> SATISFACTORY MODS </h1>

	<br/><br/>

	<div class="flex flex-wrap place-content-center">

		<ModCard
				title="Factory Props"
				description="The Ultimate Decorating Toolkit!"
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/8ivr6Mvuv4sCkX/logo.webp"
				link="https://ficsit.app/mod/Factory_Prop_Mod"
				github="https://github.com/SpaceGameDev568/Factory_Prop_Mod"
		/>

		<ModCard
				title="Discord Rich Presence"
				description="Show off your Satisfactory presence info on your Discord profile!"
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/2t2nCEBqMdUt1n/logo.webp"
				link="https://ficsit.app/mod/FG_DiscordRP"
				github="https://github.com/SpaceGameDev568/FG_DiscordRP"
		/>

		<ModCard
				title="Remove All Annoyances"
				description="Removes annoying things from the world."
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/FGnDVTV2ygmANY/logo.webp"
				link="https://ficsit.app/mod/RemoveAllAnnoyances"
				github="https://github.com/SpaceGameDev568/RemoveAllAnnoyances"
		/>

		<ModCard
				title="Better Grass"
				description="More beautiful grass for your game."
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/4S2xwMEFdMKymS/logo.webp"
				link="https://ficsit.app/mod/BetterGrass"
				github="https://github.com/SpaceGameDev568/BetterGrass"
		/>

		<ModCard
				title="SatisWHACKtory"
				description="FICSIT Inc. is not responsible for any injuries caused by the use of this mod."
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/8XYLMRNbnfzc2G/logo.webp"
				link="https://ficsit.app/mod/ObstacleMod"
				github="https://github.com/SpaceGameDev568/ObstacleMod"
		/>

		<ModCard
				title="Mod Update Notifier"
				description="This mod will notify you whenever a supported mod has an update available!"
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/8KzYMxowiUmKLn/logo.webp"
				link="https://ficsit.app/mod/ModUpdateNotifier"
				github="https://github.com/SpaceGameDev568/ModUpdateNotifier"
		/>

		<ModCard
				title="2m Walls"
				description="2m high walls for the extra efficient builder."
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/7NEYeWC3Mf5Rqa/logo.webp"
				link="https://ficsit.app/mod/TwoMeterWalls"
				github="https://github.com/SpaceGameDev568/TwoMeterWalls"
		/>

		<ModCard
				title="More Players"
				description="Allows you to have more than just 4 people in your game."
				image="https://storage.ficsit.app/file/smr-prod-s3/images/mods/CMA7t3H6L1dkWT/logo.webp"
				link="https://ficsit.app/mod/MorePlayers"
				github="https://github.com/SpaceGameDev568/MorePlayers"
		/>

	</div>

	<br/><br/>

	<hr class="border-black dark:border-white border-opacity-20 dark:border-opacity-20"/>

	<br/><br/>

	<h1 class="text-5xl font-bold ml-auto mr-auto w-fit text-black dark:text-white font-heading"> CONTACT </h1>

	<br/><br/>

	<ContactForm />

</Layout>