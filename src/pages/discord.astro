
---
import {Image} from 'astro:assets';

import Layout from "@layouts/Layout.astro";
import ActionButton from "@components/buttons/ActionButton.astro";

import OrgLogoFlat from "@assets/images/OrgLogoFlat.svg";
---


<Layout title="SpaceGameDev / Discord">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<div id="content" class="md:border border-white/10 md:bg-background-primary/25 backdrop-blur-sm md:box-border w-85.5 border-box m-auto">

		<div class="m-5 mb-10">
			<Image
					src={OrgLogoFlat}
					alt="SpaceGameDev"
					width="342"
					height="342"
					loading="eager"
			/>

			<br/>

			<p class="text-4xl font-bold text-white font-heading">SpaceGameDev Modding</p>

			<p class="text-gray-400 h-10">Discord server</p>

			<p class="text-white text-xl">Get help, see project announcements, and chat with other cool people!</p>

			<br/><br/>

			<ActionButton
					title="Join"
					link="https://discord.gg/tgNjem4bjU"
					variant="large_primary"
					target="_self"
			/>
		</div>

	</div>

	<script>
		import { animate } from "motion"

		document.addEventListener('astro:page-load', () => {
			animate("#content", { y: [225, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
		});
	</script>

</Layout>