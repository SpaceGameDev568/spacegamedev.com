---
import Layout from "../layouts/Layout.astro";
import {Image} from "astro:assets";

import profilePicture from '../../public/images/ProfilePicture.png';

import BioButton from "../components/BioButton.astro";

import BHLogo from "../../public/images/BisectHostingLogomark.svg"
import DiscordLogo from "../../public/images/Icons/Discord.svg";
import GitHubLogo from '../../public/images/Icons/GitHub2.svg';
import GitLabLogo from '../../public/images/Icons/GitLab.svg';
import LinkedInLogo from '../../public/images/Icons/LinkedIn.svg';
import YouTubeLogo from '../../public/images/Icons/YouTube.svg';
import SteamLogo from '../../public/images/Icons/Steam2.svg';
import InstagramLogo from '../../public/images/Icons/Instagram.png';
import TwitchLogo from '../../public/images/Icons/Twitch.svg';
import SMRLogo from '../../public/images/Icons/SMR.webp';
import WebsiteLogo from '../../public/images/Favicon.svg';
import XLogo from '../../public/images/Icons/X2.svg';

---

<Layout title="SpaceGameDev / LinkInBio">

	<div id="header-spacer" class="h-[50px] mb-10"/>

	<div id="content" class="lg:border border-white/10 lg:rounded-2xl lg:bg-[#222225] lg:box-border lg:p-5 w-fit ml-auto mr-auto">

		<Image
				src={profilePicture}
				alt="Me"
				width="342"
				height="342"
				class="rounded-2xl ml-auto mr-auto w-fit"
				loading="eager"
		/>

		<br/>

		<h2 class="text-4xl font-bold ml-auto mr-auto w-fit text-center text-white"> SpaceGameDev </h2>

		<br/>

		<div class="w-[342px] ml-auto mr-auto">

		<a href="https://www.buymeacoffee.com/spacegamedev" class="ml-auto mr-auto w-[342px]">
			<img
				src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=☕&slug=spacegamedev&button_colour=FFDD00&font_colour=000001&font_family=Cookie&outline_colour=000000&coffee_colour=ffffff"
				alt="Buy Me A Coffee"
				class="shadow-md duration-300 ml-auto mr-auto w-[342px] h-[74] hover:ring-4 box-border rounded-2xl ring-white/20"
			/>
		</a>

		<br/>

			<BioButton
					title="Website"
					link="/"
					image={WebsiteLogo}
					alt="My Website"
			/>

			<BioButton
					title="Satisfactory Mods"
					link="https://ficsit.app/user/5GqLMHyzA3myPG"
					image={SMRLogo}
					alt="SpaceGameDev on SMR"
			/>

			<BioButton
					title="BisectHosting"
					link="/hosting"
					image={BHLogo}
					alt="BisectHosting"
			/>

			<BioButton
					title="Discord"
					link="https://discord.gg/tgNjem4bjU"
					image={DiscordLogo}
					alt="Discord"
			/>

			<BioButton
					title="GitHub"
					link="https://github.com/SpaceGameDev568"
					image={GitHubLogo}
					alt="SpaceGameDev568 on GitHub"
			/>

			<BioButton
					title="GitLab"
					link="https://gitlab.com/SpaceGameDev568"
					image={GitLabLogo}
					alt="SpaceGameDev568 on GitLab"
			/>

			<BioButton
					title="Instagram"
					link="https://www.instagram.com/jessehodgsonaviation"
					image={InstagramLogo}
					alt="@jessehodgsonaviation on Instagram"
			/>

			<BioButton
					title="LinkedIn"
					link="https://www.linkedin.com/in/jesse-hodgson/"
					image={LinkedInLogo}
					alt="Jesse Hodgson on LinkedIn"
			/>

			<BioButton
					title="Steam"
					link="https://steamcommunity.com/id/spacegamedev/"
					image={SteamLogo}
					alt="SpaceGameDev on Steam"
			/>

			<BioButton
					title="Twitch"
					link="https://www.twitch.tv/spacegamedev568"
					image={TwitchLogo}
					alt="SpaceGameDev568 on Twitch"
			/>

			<BioButton
					title="X"
					link="https://x.com/SpaceGameDev568"
					image={XLogo}
					alt="@SpaceGameDev568 on X"
			/>

			<BioButton
					title="YouTube"
					link="https://youtube.com/@spacegamedev"
					image={YouTubeLogo}
					alt="@spacegamedev on YouTube"
			/>

		</div>

	</div>

	<script>
		import { animate } from "motion"

		document.addEventListener('astro:page-load', () => {
			animate("#content", { y: [400, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
		});
	</script>

	<br/>

</Layout>