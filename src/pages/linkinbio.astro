---
import Layout from "@layouts/Layout.astro";
import {Image} from "astro:assets";

import profilePicture from '@assets/images/ProfilePictureVector.png';

import BioButton from "@components/buttons/BioButton.astro";

import BHLogo from "@assets/images/BisectHostingLogomark.svg"
import DiscordLogo from "@assets/images/Icons/Discord.svg";
import GitHubLogo from '@assets/images/Icons/GitHub2.svg';
import GitLabLogo from '@assets/images/Icons/GitLab.svg';
import YouTubeLogo from '@assets/images/Icons/YouTube.svg';
import SteamLogo from '@assets/images/Icons/Steam2.svg';
import InstagramLogo from '@assets/images/Icons/Instagram.png';
import TwitchLogo from '@assets/images/Icons/Twitch.svg';
import SMRLogo from '@assets/images/Icons/SMR.webp';
import ModrinthLogo from '@assets/images/Icons/Modrinth.svg';
import WebsiteLogo from '@assets/images/OrgLogo.svg';
import XLogo from '@assets/images/Icons/X2.svg';
import LinkedInLogo from '@assets/images/Icons/LinkedIn.png';

---

<Layout title="SpaceGameDev / LinkInBio">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<div id="content" class="md:border border-white/10 md:bg-background-primary/25 md:backdrop-blur-sm md:box-border md:p-5 w-fit m-auto">

		<Image
				src={profilePicture}
				alt="Me"
				class="m-auto w-85.5"
				loading="eager"
		/>

		<br/>

		<h2 class="text-4xl font-bold m-auto w-fit text-center animate-rgb-cycle font-bh-sans"> SpaceGameDev </h2>

		<br/>

		<div class="w-85.5 m-auto">

		<a href="https://www.buymeacoffee.com/spacegamedev" class="m-auto w-85.5">
			<img
				src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=☕&slug=spacegamedev&button_colour=FFDD00&font_colour=000001&font_family=Cookie&outline_colour=000000&coffee_colour=ffffff"
				alt="Buy Me A Coffee"
				class="shadow-md duration-300 m-auto w-85.5 h-[74] hover:ring-4 box-border rounded-2xl ring-white/20"
			/>
		</a>

		<br/>

			<BioButton
					title="Website"
					link="/"
					image={WebsiteLogo}
					alt="My Website"
			/>

			<BioButton
					title="Satisfactory Mods"
					link="https://ficsit.app/user/5GqLMHyzA3myPG"
					image={SMRLogo}
					alt="SpaceGameDev on SMR"
			/>

			<BioButton
					title="Modrinth"
					link="https://modrinth.com/organization/spacegamedev-modding"
					image={ModrinthLogo}
					alt="SpaceGameDev Modding on Modrinth"
			/>

			<BioButton
					title="BisectHosting"
					link="/hosting"
					image={BHLogo}
					alt="BisectHosting"
			/>

			<BioButton
					title="Discord"
					link="https://discord.gg/tgNjem4bjU"
					image={DiscordLogo}
					alt="Discord"
			/>

			<BioButton
					title="GitHub"
					link="https://github.com/SpaceGameDev568"
					image={GitHubLogo}
					alt="SpaceGameDev568 on GitHub"
			/>

			<!--
			<BioButton
					title="GitLab"
					link="https://gitlab.com/SpaceGameDev568"
					image={GitLabLogo}
					alt="SpaceGameDev568 on GitLab"
			/>

			-->

			<BioButton
					title="YouTube"
					link="https://youtube.com/@spacegamedev"
					image={YouTubeLogo}
					alt="@spacegamedev on YouTube"
			/>

			<BioButton
					title="LinkedIn"
					link="https://www.linkedin.com/in/jesse-hodgson/"
					image={LinkedInLogo}
					alt="Jesse Hodgson on GitHub"
			/>

			<BioButton
					title="X"
					link="https://x.com/SpaceGameDev568"
					image={XLogo}
					alt="@SpaceGameDev568 on X"
			/>

			<BioButton
					title="Instagram"
					link="https://www.instagram.com/jessehodgsonaviation"
					image={InstagramLogo}
					alt="@jessehodgsonaviation on Instagram"
			/>

			<BioButton
					title="Steam"
					link="https://steamcommunity.com/id/spacegamedev/"
					image={SteamLogo}
					alt="SpaceGameDev on Steam"
			/>

			<!--
			<BioButton
					title="Twitch"
					link="https://www.twitch.tv/spacegamedev568"
					image={TwitchLogo}
					alt="SpaceGameDev568 on Twitch"
			/>
			-->
		</div>

	</div>

	<script>
		import { animate } from "motion"

		document.addEventListener('astro:page-load', () => {
			animate("#content", { y: [225, 0], opacity: [0, 100] }, { ease: "easeInOut", duration: 1} )
		});
	</script>

	<br/>

</Layout>